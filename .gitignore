# Terraform
terraform/terraform.tfvars
terraform/.terraform/
terraform/.terraform.lock.hcl
# Match any state file variant. State holds resolved secret values in
# plaintext (SSM SecureStrings, random_password results, API keys), so the
# pattern is deliberately broad: suffixed copies like
# terraform.tfstate.old-<account> escaped the narrower *.tfstate rule.
terraform/*.tfstate*
terraform/*.backup
terraform/.build/
terraform/plan.out

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.hypothesis/

# Node/Frontend
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
._*

# Secrets
*.pem
*.key
.env
.env.production
.env.local
.env.*.local

# Python virtual environment
.venv/

# Export output
export/
.export-push-tmp/